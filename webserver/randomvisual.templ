package main

templ randomvisual(root Node) {

<!DOCTYPE html>
<html>

@style()

<body>
    <div class="center">
    @homebutton()

    @links()

    <h3>Random LUCA Tree</h3>

    <pre style="font-family: monospace; text-align: left; display: inline-block;">@templ.Raw(renderHTML(root))</pre>

    </div>

</body>

</html>

}