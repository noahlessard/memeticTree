package main

templ style() {
<head>
    <title>Memetic Tree</title>
<style>
  h1 {color:red;}

  .center {
    text-align: center;
    max-width: 75%;
    margin: auto;
  }

  .center-image-text {
    display: flex;
    align-items: center;
    gap: 30px;
    justify-content: center;
  }

  .main-img {
    height: 400px;
  }

  .tree-img {
    height: 600px;
  }

  .h2-row {
    display: flex;
    gap: 20px;
    justify-content: center;
  }

  .border {
    border: solid black 2px;
    max-width: 600px;
    padding-left: 5%;
    padding-right: 5%;
    margin: auto;
  }

  .invis {
    color: red;
    text-decoration: underline;
  }

</style>
</head>
}