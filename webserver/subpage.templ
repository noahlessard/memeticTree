package main

// variables must be declared outside of templ function
func getNodeName(node Node) string {
	nameString := node.Name
	if len(node.Parents) == 0 {
		nameString = "LUCA: " + nameString
	}
	return nameString
}

templ subpage(node Node) {

<!DOCTYPE html>
<html>

@style()


<body>
    <div class="center">
    @homebutton()    
    
    @links()

    <h3> { getNodeName(node) }</h3>

    <div class="border">

    @offspring("Memetic Ancestors", node.Parents)

    <div class="center-image-text">
        <img src={ node.ImagePath } class="tree-img">
         <p>
             { node.Description }
         </p>

    </div>

    <br><br>

    @offspring("Memetic Offspring", node.Children)

    </div>

</div>

</body>

</html>

}